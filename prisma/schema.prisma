// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================
// SUBSCRIPCIÓN
// ========================
model SubscriptionPlan {
  id          String    @id @default(uuid())
  name        PlanType  @unique
  description String?
  price       Float     // Precio mensual
  features    Json      // Lista de beneficios/características del plan

  subscriptions UserSubscription[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserSubscription {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])

  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])

  startDate        DateTime         @default(now())
  renewalDate      DateTime
  active           Boolean          @default(true)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// ========================
// USER MANAGEMENT
// ========================
model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String

  profile           UserProfile?
  tokens            UserToken[]
  recovery          UserRecovery?

  lifeWheel         LifeWheel[]
  contexts          Context[]         // ✅ Contextos globales de cada usuario
  answers           Answer[]          // ✅ NUEVO: Relación con las respuestas del usuario

  subscription      UserSubscription?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model UserProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])

  firstName String
  lastName  String
  address   String
  phone     String
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserToken {
  id           String @id @default(uuid())
  userId       String @unique // ✅ Un solo token por usuario
  user         User   @relation(fields: [userId], references: [id])

  accessToken  String
  refreshToken String?
  expiresAt    DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserRecovery {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id])

  recoveryEmail    String?
  securityQuestion String?
  securityAnswer   String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ========================
// LIFEWHEEL
// ========================
model LifeWheel {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])

  lifeAreas   LifeWheelArea[]
  globalScore Float          // Promedio de los scores de las áreas

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// MODIFICADO: LifeWheelArea ahora se relaciona con el modelo Area
model LifeWheelArea {
  id          String       @id @default(uuid())
  lifeWheelId String
  lifeWheel   LifeWheel    @relation(fields: [lifeWheelId], references: [id])

  areaId      String
  area        Area         @relation(fields: [areaId], references: [id])

  score       Float          // Promedio de respuestas (Answers)

  answers     Answer[]     // Se relaciona con Answer en lugar de Question
  projects    GtdProject[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([lifeWheelId, areaId])
}

// ========================
// ÁREAS, PREGUNTAS Y RESPUESTAS
// ========================

// ✅ NUEVO MODELO: Area (reemplaza al enum LifeArea)
model Area {
  id          String @id @default(uuid())
  name        String @unique // e.g., PERSONAL_DEVELOPMENT, PROFESSIONAL_ACTIVITY, etc.
  description String // e.g., "Desarrollo Personal", "Actividad Profesional", etc.

  lifeWheelAreas LifeWheelArea[]
  questions      Question[]
  projectDetails GtdProjectDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ✅ MODIFICADO: Question ahora depende de Area
model Question {
  id      String   @id @default(uuid())
  text    String

  areaId  String
  area    Area     @relation(fields: [areaId], references: [id])

  answers Answer[] // Una pregunta puede tener muchas respuestas de diferentes usuarios/ruedas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ✅ NUEVO MODELO: Answer para las respuestas de los usuarios
model Answer {
  id              String        @id @default(uuid())
  value           Boolean       // Sí = true, No = false

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId      String
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  lifeWheelAreaId String
  lifeWheelArea   LifeWheelArea @relation(fields: [lifeWheelAreaId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, questionId, lifeWheelAreaId])
}


// ========================
// PROJECTS
// ========================
model GtdProject {
  id              String         @id @default(uuid())
  lifeWheelAreaId String
  lifeWheelArea   LifeWheelArea  @relation(fields: [lifeWheelAreaId], references: [id])

  title           String
  description     String?
  status          ProjectStatus  @default(ACTIVE)

  detail          GtdProjectDetail?
  budget          Budget?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ✅ MODIFICADO: GtdProjectDetail ahora se relaciona con el modelo Area
model GtdProjectDetail {
  id          String         @id @default(uuid())
  projectId   String         @unique
  project     GtdProject     @relation(fields: [projectId], references: [id])

  lifeAreaId  String
  lifeArea    Area           @relation(fields: [lifeAreaId], references: [id])

  status      ProjectDetailStatus @default(PLANNING)

  startDate   DateTime
  endDate     DateTime

  // Metas unificadas (BE–DO–HAVE)
  goals       ProjectGoal[]

  completedActions   Int   @default(0)
  totalActions       Int   @default(0)
  progressPercentage Float @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================
// GOALS (Unified)
// ========================
model ProjectGoal {
  id        String   @id @default(uuid())
  detailId  String
  detail    GtdProjectDetail @relation(fields: [detailId], references: [id])

  goalType  GoalType // BE, DO, HAVE
  content   String

  cost      Float?   // 💰 costo asociado
  saved     Float?   // 💵 ahorro/acumulado

  actions   GtdAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// ACTIONS
// ========================
model GtdAction {
  id          String       @id @default(uuid())
  goalId      String
  goal        ProjectGoal  @relation(fields: [goalId], references: [id])

  contextId   String?
  context     Context?     @relation(fields: [contextId], references: [id])

  title       String
  description String?

  energy      EnergyLevel
  timeEstimate Int?

  dueDate     DateTime?
  completed   Boolean @default(false)
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================
// CONTEXT
// ========================
model Context {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  actions   GtdAction[]   // ✅ Relación 1:N con acciones

  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name]) // ✅ Un contexto único por usuario
}

// ========================
// BUDGET (IMO / IDO)
// ========================
model Budget {
  id          String     @id @default(uuid())
  projectId   String     @unique
  project     GtdProject @relation(fields: [projectId], references: [id])

  monthlyIncomeTarget Float? // IMO opcional
  dailyIncomeTarget   Float? // IDO opcional

  currencyId  String
  currency    Currency   @relation(fields: [currencyId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ========================
// CURRENCY
// ========================
model Currency {
  id       String   @id @default(uuid())
  code     String   @unique // Ej: "USD", "MXN"
  name     String   // Ej: "US Dollar", "Peso Mexicano"
  symbol   String   // Ej: "$"

  budgets  Budget[]
}

// ========================
// ENUMS
// ========================

// ELIMINADO: El enum LifeArea fue reemplazado por el modelo Area

enum ProjectDetailStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ProjectStatus {
  ACTIVE
  SOMEDAY
  COMPLETED
  CANCELLED
}

enum EnergyLevel {
  HIGH
  MEDIUM
  LOW
}

enum GoalType {
  BE
  DO
  HAVE
}

enum PlanType {
  BASICO
  INTERMEDIO
  AVANZADO
}
