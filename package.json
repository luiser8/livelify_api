{
  "name": "livelify_api",
  "version": "1.0.0",
  "description": "Livelify API Application",
  "author": "Luis Rondón",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "APP_ENV=development nest start --watch",
    "start:qa": "APP_ENV=qa nest start --watch",
    "start:prod": "APP_ENV=production node dist/main",
    "start:debug": "APP_ENV=development nest start --debug --watch",
    "start:debug:qa": "APP_ENV=qa nest start --debug --watch",
    "start:debug:prod": "APP_ENV=production nest start --debug --watch",
    "prisma:generate": "prisma generate",
    "prisma:generate:dev": "APP_ENV=development prisma generate",
    "prisma:generate:qa": "APP_ENV=qa prisma generate",
    "prisma:generate:prod": "APP_ENV=production prisma generate",
    "prisma:migrate:dev": "APP_ENV=development prisma migrate dev",
    "prisma:migrate:qa": "APP_ENV=qa prisma migrate dev",
    "prisma:migrate:prod": "APP_ENV=production prisma migrate deploy",
    "prisma:deploy:dev": "APP_ENV=development prisma migrate deploy",
    "prisma:deploy:qa": "APP_ENV=qa prisma migrate deploy",
    "prisma:deploy:prod": "APP_ENV=production prisma migrate deploy",
    "prisma:studio:dev": "APP_ENV=development prisma studio",
    "prisma:studio:qa": "APP_ENV=qa prisma studio",
    "prisma:studio:prod": "APP_ENV=production prisma studio",
    "prisma:reset:dev": "APP_ENV=development prisma migrate reset --force",
    "prisma:reset:qa": "APP_ENV=qa prisma migrate reset --force",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:dev": "APP_ENV=development ts-node prisma/seed.ts",
    "prisma:seed:qa": "APP_ENV=qa ts-node prisma/seed.ts",
    "db:setup:dev": "npm run prisma:generate:dev && npm run prisma:migrate:dev && npm run prisma:seed:dev",
    "db:setup:qa": "npm run prisma:generate:qa && npm run prisma:migrate:qa && npm run prisma:seed:qa",
    "db:setup:prod": "npm run prisma:generate:prod && npm run prisma:deploy:prod",
    "env:copy:dev": "cp env.development.example .env.development 2>/dev/null || echo 'Copy manually: env.development.example -> .env.development'",
    "env:copy:qa": "cp env.qa.example .env.qa 2>/dev/null || echo 'Copy manually: env.qa.example -> .env.qa'",
    "env:copy:prod": "cp env.production.example .env.production 2>/dev/null || echo 'Copy manually: env.production.example -> .env.production'",
    "env:copy:all": "npm run env:copy:dev && npm run env:copy:qa && npm run env:copy:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@types/uuid": "11.0.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "prisma": "6.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.1.6",
    "@prisma/client": "6.16.3",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.3",
    "@types/helmet": "4.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.6.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
