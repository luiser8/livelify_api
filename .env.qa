# =============================================================================
# QA/TESTING ENVIRONMENT CONFIGURATION
# =============================================================================
# Este archivo contiene las configuraciones para el ambiente de QA/Testing
# Utilizado cuando APP_ENV=qa o con el comando: npm run start:qa

# -----------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Define el ambiente actual de la aplicación
APP_ENV=qa

# -----------------------------------------------------------------------------
# API SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración del servidor para ambiente de QA
APP_PORT=3000
APP_PREFIX=api
APP_VERSION=v1
APP_TITLE=Livelify API - QA
APP_DESCRIPTION=Livelify API - QA/Testing Environment

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración de conexión a la base de datos PostgreSQL para QA
# Debe apuntar al servidor de base de datos de testing/QA
# Usualmente contiene datos de prueba y no datos reales
DATABASE_URL="postgresql://user:password@qa-server:5432/livelify_qa"

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración para autenticación en ambiente de QA
# APP_JWT_SECRET: Clave secreta diferente a desarrollo y producción
# CRÍTICO: Nunca usar la misma clave en diferentes ambientes
APP_JWT_SECRET=your-qa-jwt-secret-key-here
# APP_JWT_EXPIRE: Tiempo de expiración más largo para facilitar testing
APP_JWT_EXPIRE=2h

# -----------------------------------------------------------------------------
# SWAGGER/OpenAPI DOCUMENTATION CONFIGURATION
# -----------------------------------------------------------------------------
# En QA Swagger está habilitado para que testers puedan usar la interfaz
APP_SWAGGER_UI=true

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración CORS para el dominio/subdomain de QA
# APP_ALLOWED_ORIGINS: Apunta al dominio de QA donde corre el frontend de testing
APP_ALLOWED_ORIGINS=https://qa.livelify.com;https://qa-admin.livelify.com

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Nivel 'info' proporciona información suficiente sin saturar logs
# Útil para debugging pero menos verboso que development
LOG_LEVEL=info

# ================================
# 🚦 RATE LIMITING CONFIGURATION (QA - More Restrictive)
# ================================
# Default rate limiting (general API usage): 50 requests per minute
THROTTLE_TTL=60000
THROTTLE_LIMIT=50

# Authentication rate limiting (login, register): 3 attempts per 15 minutes
THROTTLE_AUTH_TTL=900000
THROTTLE_AUTH_LIMIT=3

# Strict rate limiting (profile updates, sensitive ops): 5 requests per minute
THROTTLE_STRICT_TTL=60000
THROTTLE_STRICT_LIMIT=5
