# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Este archivo contiene las configuraciones para el ambiente de producción
# Utilizado cuando APP_ENV=production o con el comando: npm run start:prod
# CRÍTICO: Todos los valores deben ser seguros y específicos para producción

# -----------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Define el ambiente actual de la aplicación
APP_ENV=

# -----------------------------------------------------------------------------
# API SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración del servidor para producción
APP_PORT=
APP_PREFIX=
APP_VERSION=
APP_TITLE=
APP_DESCRIPTION=

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración de conexión a la base de datos PostgreSQL de producción
# IMPORTANTE: Debe apuntar al servidor de producción con datos reales
# Usar conexiones SSL y credenciales seguras
DATABASE_URL=

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración crítica de seguridad para producción
# APP_JWT_SECRET: Debe ser una clave extremadamente segura y única
# NUNCA usar la misma clave que development o QA
APP_JWT_SECRET=
# APP_JWT_EXPIRE: Tiempo de expiración del token de acceso (1h = 1 hora)
APP_JWT_EXPIRE=
# APP_JWT_REFRESH_EXPIRE: Tiempo de expiración del token de refresco (1h = 24 horas)
APP_JWT_REFRESH_EXPIRE=

# -----------------------------------------------------------------------------
# SWAGGER/OpenAPI DOCUMENTATION CONFIGURATION
# -----------------------------------------------------------------------------
# En producción Swagger está DESHABILITADO por seguridad
# No exponer documentación de API en ambiente productivo
APP_SWAGGER_UI=

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración CORS restrictiva para producción
# APP_ALLOWED_ORIGINS: Solo los dominios oficiales de producción
# NUNCA usar '*' o dominios de desarrollo/testing
APP_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Nivel 'warn' para reducir logs y mejorar performance
# Solo registra warnings y errores críticos
LOG_LEVEL=

# ================================
# 🚦 RATE LIMITING CONFIGURATION (Production - Very Restrictive)
# ================================
# Default rate limiting (general API usage): 20 requests per minute
THROTTLE_TTL=
THROTTLE_LIMIT=

# -----------------------------------------------------------------------------
# DIAGNOSTIC EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
DIAGNOSTIC_SEND_EMAIL=
DIAGNOSTIC_REQUIRE_API_KEY=
DIAGNOSTIC_API_KEYS=

# -----------------------------------------------------------------------------
# SENDGRID MARKETING CONFIGURATION
# -----------------------------------------------------------------------------
# SendGrid API Key for marketing contacts
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
SENDGRID_FROM_EMAIL=
SENDGRID_TEMPLATE_ID=
