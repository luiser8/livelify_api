# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Este archivo contiene las configuraciones para el ambiente de desarrollo local
# Utilizado cuando APP_ENV=development o con el comando: npm run start:dev

# -----------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Define el ambiente actual de la aplicación
APP_ENV=development

# -----------------------------------------------------------------------------
# API SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración del servidor HTTP
# APP_PORT: Puerto donde correrá la aplicación
APP_PORT=3000
# APP_PREFIX: Prefijo base para todas las rutas de la API (api)
APP_PREFIX=api
# APP_VERSION: Versión de la API (v1) - se combina con prefix para formar /api/v1
APP_VERSION=v1
# APP_TITLE: Título de la aplicación para Swagger
APP_TITLE=Livelify API
# APP_DESCRIPTION: Descripción para documentación
APP_DESCRIPTION=Livelify API - Development Environment

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración de conexión a la base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# Para desarrollo local, usualmente se conecta a localhost
DATABASE_URL="postgresql://livelify_user:livelify_password@localhost:5432/livelify"

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración para autenticación y autorización de usuarios
# APP_JWT_SECRET: Clave secreta para firmar y verificar tokens JWT
# IMPORTANTE: Debe ser única y segura para cada ambiente
APP_JWT_SECRET=DcwDcUqI3v36gygq47TmQ+yYOlB0UDYJwFt600dNr14=
# APP_JWT_EXPIRE: Tiempo de expiración del token de acceso (1h = 1 hora)
APP_JWT_EXPIRE=7h
# APP_JWT_REFRESH_EXPIRE: Tiempo de expiración del token de refresco (1h = 24 horas)
APP_JWT_REFRESH_EXPIRE=24h

# -----------------------------------------------------------------------------
# SWAGGER/OpenAPI DOCUMENTATION CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración para la documentación automática de la API
# APP_SWAGGER_UI: Habilita/deshabilita la interfaz de Swagger
# En desarrollo siempre debe estar habilitado para facilitar testing
APP_SWAGGER_UI=true

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# -----------------------------------------------------------------------------
# Configuración para permitir requests desde otros dominios
# APP_ALLOWED_ORIGINS: Dominios permitidos separados por punto y coma
# En desarrollo usualmente es localhost con diferentes puertos
APP_ALLOWED_ORIGINS=http://localhost:3000;http://localhost:3001;http://localhost:4200;http://localhost:5173

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
# Nivel de logging para debugging y monitoreo
# Niveles: error, warn, info, debug, verbose
# En desarrollo se usa 'debug' para máxima información
LOG_LEVEL=debug


# ================================
# 🚦 RATE LIMITING CONFIGURATION
# ================================
# Default rate limiting (general API usage): 100 requests per minute
THROTTLE_TTL=60000
THROTTLE_LIMIT=200

# -----------------------------------------------------------------------------
# DIAGNOSTIC EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Habilitar/deshabilitar envío de email con PDF en diagnósticos
# true: Guarda en BD + genera PDF + envía email
# false: Solo guarda en BD (útil para testing o ambientes sin SMTP)
DIAGNOSTIC_SEND_EMAIL=true
DIAGNOSTIC_REQUIRE_API_KEY=
DIAGNOSTIC_API_KEYS=

# -----------------------------------------------------------------------------
# SENDGRID MARKETING CONFIGURATION
# -----------------------------------------------------------------------------
# SendGrid API Key for marketing contacts
SENDGRID_API_KEY=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
SENDGRID_LIST_ID=a128151e-d55b-4546-91a0-95ff9b3c1734
SENDGRID_FROM_EMAIL=imedinag@flowpartners.cl
SENDGRID_TEMPLATE_ID=d-93e3e8ad57fc4cb992e547311b2bfa23
